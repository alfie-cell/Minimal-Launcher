<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <dev.minimal.launcher.SwipeLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/home_gutter"
        android:paddingVertical="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clock"
                style="@style/HomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?android:attr/selectableItemBackground"
                android:fontFamily="sans-serif-light"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textSize="68sp" />

            <TextClock
                android:id="@+id/date"
                style="@style/HomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />

            <!-- Upcoming events: height is set in code to show at most 3 rows; scrolls for more. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/agenda"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:fadingEdgeLength="14dp"
                android:overScrollMode="never"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none"
                android:visibility="gone" />

            <TextView
                android:id="@+id/agenda_hint"
                style="@style/HomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="?android:attr/selectableItemBackground"
                android:paddingVertical="4dp"
                android:text="@string/agenda_hint"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/home_hint"
                style="@style/HomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/home_hint"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- Dock: favourite apps as icons, one row, cells of equal width. -->
            <LinearLayout
                android:id="@+id/favorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:weightSum="5" />
        </LinearLayout>

        <View
            android:id="@+id/menu_anchor"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:importantForAccessibility="no" />
    </dev.minimal.launcher.SwipeLayout>

    <dev.minimal.launcher.SwipeLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/drawer_bg"
        android:visibility="gone">

        <!-- Grid above, search at the bottom for one-handed use. Bottom padding tracks the
             keyboard/nav bar (see HomeActivity.applyInsets). -->
        <LinearLayout
            android:id="@+id/drawer_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="8dp"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/no_results"
                    style="@style/HomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="32dp"
                    android:text="@string/no_results"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </FrameLayout>

            <EditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/search_bg"
                android:hint="@string/search_hint"
                android:imeOptions="actionGo|flagNoExtractUi|flagNoPersonalizedLearning"
                android:importantForAutofill="no"
                android:inputType="textFilter|textNoSuggestions"
                android:maxLength="64"
                android:paddingHorizontal="20dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textCursorDrawable="@null"
                android:textSize="17sp" />
        </LinearLayout>
    </dev.minimal.launcher.SwipeLayout>
</FrameLayout>
